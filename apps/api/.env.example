# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fast_homes_crm"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-secret-key-change-in-production"

# SMS test mode: when true, outbound SMS only goes to allowlisted numbers.
SMS_TEST_MODE="false"
SMS_ALLOWED_NUMBERS=""  # comma-separated, e.g. "+17045551234,+18285555678"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Default outbound number. Used for ALL outbound SMS, and as the dialer's caller
# ID when TWILIO_CALLER_IDS is unset.
TWILIO_PHONE_NUMBER="+18885748121"

# Outbound caller IDs offered in the dialer's "Calling From" picker, as a
# comma-separated list of `+1NNNNNNNNNN` or `Label:+1NNNNNNNNNN` entries. The
# first entry is the default selection. A number the browser sends is only
# honoured if it appears here, so this doubles as the anti-spoofing allowlist.
# Unlabelled entries display as their formatted number.
# Seeds the phone_numbers table on first boot only. After that Settings >
# Phone Numbers is the source of truth for both caller ID and the SMS
# "From", and editing this has no effect.
TWILIO_CALLER_IDS="Main:+18885748121,Charlotte:+17045299523,Jacksonville:+19045959620"
# Delivery receipts: passed as statusCallback on every send.
# Point at this API's public URL.
TWILIO_STATUS_CALLBACK_URL="https://api.mydealcore.com/webhooks/twilio/status"
# Public base URL Twilio POSTs webhooks to - used for signature validation behind
# the Railway proxy. Set to the API's public origin (no trailing slash).
TWILIO_WEBHOOK_BASE_URL="https://api.mydealcore.com"
# Set to false to skip webhook signature validation (local/ngrok testing only)
TWILIO_VALIDATE_WEBHOOKS="true"
# Overrides what the agent hears while the seller's phone rings on a browser
# call. Leave unset: the API serves a standard ring tone at
# /calls/twilio/ringback.wav, which is what you want. Set this only to use a
# different sound (any URL returning audio or TwiML).
TWILIO_RINGBACK_URL=""

# Twilio browser dialer (Programmable Voice). Dormant until all three are set.
# API Key: Console > Account > API keys & tokens > Create API Key (Standard).
TWILIO_API_KEY_SID="SK..."
TWILIO_API_KEY_SECRET="your-api-key-secret"  # shown once at creation
# TwiML App: Console > Voice > TwiML > TwiML Apps. Set its Voice Request URL to
# https://<api-domain>/calls/twilio/voice  (this powers OUTBOUND browser calls)
TWILIO_TWIML_APP_SID="AP..."
# INBOUND: set your Twilio number's "A call comes in" Voice webhook to
# https://<api-domain>/calls/twilio/incoming  (rings the agents' browser dialers).
# Optional: restrict which client identities (userIds) ring; default rings all users.
TWILIO_INBOUND_RING_IDENTITIES=""  # e.g. "userId1,userId2"
# Call recording (off by default). Set true to record calls; the recording is
# transcribed via OpenAI (OPENAI_API_KEY) and run through CAMP extraction.
# When true, set a spoken disclosure for two-party-consent states.
TWILIO_RECORD_CALLS="false"
TWILIO_RECORDING_DISCLOSURE="This call may be recorded for quality purposes."

# Mobile push notifications (APNs). Dormant until all four are set. Powers
# new-lead / new-message alerts to the iOS app. Create an APNs Auth Key (.p8) at
# developer.apple.com > Certificates, IDs & Profiles > Keys (Apple Push Notifications).
APNS_AUTH_KEY_P8=""        # base64 of the .p8 file contents (base64 -i AuthKey_XXXX.p8)
APNS_KEY_ID=""             # 10-char Key ID shown next to the key
APNS_TEAM_ID=""            # Apple Developer Team ID
APNS_BUNDLE_ID="com.dealcore.app"  # the app's bundle identifier (APNs topic)
APNS_PRODUCTION="false"    # true once shipping via TestFlight/App Store
# For incoming-call (VoIP) push, create a Twilio Push Credential from the same APNs
# key (Console > Voice > Push Credentials) and set its SID here; the voice token
# endpoint attaches it for mobile clients (see docs/mobile-app-plan.md, phase 5).
TWILIO_APN_PUSH_CREDENTIAL_SID=""

# Anthropic Claude (primary AI provider)
# Powers all AI features: CAMP lead scoring, message draft generation, signal
# extraction, ARV calculation, and foreclosure notice parsing. Without it the
# app logs a warning and falls back to non-AI templates.
# claude-haiku-4-5 is used for data extraction, claude-sonnet-4-5 for drafts.
ANTHROPIC_API_KEY="your-anthropic-api-key"

# OpenAI (call-recording transcription only; see TWILIO_RECORD_CALLS above)
OPENAI_API_KEY="your-openai-api-key"

# RealEstateAPI (REAPI) — primary property / comps / mortgage / PropGPT provider
# Used for initial lead enrichment and as the default source on the Comps tab.
REAPI_API_KEY=""

# ATTOM_API_KEY — used by the Deal Search feature (property snapshot, foreclosure,
# skip-trace) and as an explicit comp source when chosen from the Comps tab.
ATTOM_API_KEY=""

# BatchData (validation phase — running side-by-side with REAPI on the Comps tab).
# Sandbox tokens hit the same URL but return canned dummy responses (free).
# Production tokens hit real data and bill per record returned.
BATCHDATA_API_KEY=""
BATCHDATA_ENVIRONMENT="sandbox"  # or 'production'
BATCHDATA_API_BASE_URL="https://api.batchdata.com/api/v1"

# Surplus county polls. Duval runs daily at 5:45am ET, the RealTDM counties
# (Lee so far) weekly on Monday at 4:30am ET. Set to "false" to stop both.
SURPLUS_POLL_ENABLED="true"
# RealTDM sale-date window, in months back from today. Lee escheats unclaimed
# surplus to the state one to two years after the sale, so 18 covers it.
REALTDM_LOOKBACK_MONTHS="18"
# Per-county base URL override, only for pointing at a fixture server.
# REALTDM_LEE_BASE_URL="https://lee.realtdm.com"

# Comp provider is now a per-lead setting controlled by the UI toggle on the comps-analysis page
# (stored on lead.compsProvider). No env var required.

# RentCast (comps + ARV via GET /avm/value). Part of the comps fallback chain:
# RentCast -> ChatARV -> placeholder. Responses cache for 24h; a forceRefresh
# query param bypasses the cache.
RENTCAST_API_KEY=""

# ChatARV.ai (optional - for real comps)
CHATARV_API_KEY=""

# Redis (for BullMQ - optional)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Mailgun (all outbound + inbound email)
# API key from Mailgun dashboard. MAILGUN_DOMAIN is the verified sending
# subdomain; MAILGUN_SIGNING_KEY (Settings > Webhooks) verifies inbound POSTs.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="crm.quickcashhomebuyers.com"
MAILGUN_SIGNING_KEY=""
# US region default; set to "https://api.eu.mailgun.net" for EU domains
MAILGUN_API_BASE="https://api.mailgun.net"

# From-address identities (root domain — DKIM signs as MAILGUN_DOMAIN)
# Initial lead outreach sends as deals@; user replies send as the logged-in user.
EMAIL_DEALS_FROM="deals@quickcashhomebuyers.com"
EMAIL_DEALS_FROM_NAME="Quick Cash Home Buyers"
# System/transactional (password resets) sender
SMTP_FROM="Deal Core <noreply@crm.quickcashhomebuyers.com>"

# Dig Deeper LLC, the Florida surplus-funds brand. Leads with source=SURPLUS
# send from here instead; everything else is unaffected.
#
# Leave MAILGUN_DIGDEEPER_DOMAIN empty until the domain is verified in Mailgun
# and its DNS is live. Empty means "not live yet" and surplus email falls back
# to the Quick Cash identity rather than failing, so setting this var is the
# switch that turns the brand on.
MAILGUN_DIGDEEPER_DOMAIN=""
EMAIL_DIGDEEPER_FROM="deals@digdeeperllc.com"
EMAIL_DIGDEEPER_FROM_NAME="Dig Deeper LLC"

# Campaign email sender (fallback display name if Organization.name is empty)
EMAIL_FROM_NAME="Quick Cash Home Buyers"

# Public base URL of this API — used to build email unsubscribe links
# Must be publicly reachable so one-click unsubscribe can POST to it
API_URL="https://api.mydealcore.com"

# Vapi AI Calling (optional)
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number-id"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"

# ── Scheduled county polls ───────────────────────────────────────────────────
#
# Both default to their value below when unset, so the behaviour survives an
# environment being recreated from scratch.

# Mecklenburg Times foreclosure notices, 6:30am America/New_York.
# OFF since 2026-09-01 at the team's request. The scraper and the Refresh feed
# button still work on demand; only the schedule is off. Set to "true" (exactly)
# to bring it back.
FORECLOSURE_RSS_POLL_ENABLED="false"

# Duval County tax deed surplus, 5:45am America/New_York. On by default.
# Set to "false" to stop it.
SURPLUS_POLL_ENABLED="true"

# Org that new leads from either poll are filed under. When this does not match
# the org you are viewing, leads are created but invisible on the board, which
# looks exactly like the poll having stopped.
FORECLOSURE_DEFAULT_ORG_ID=""
SURPLUS_DEFAULT_ORG_ID=""
