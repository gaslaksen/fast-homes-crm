generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("FREE")   // FREE | PRO | ENTERPRISE
  maxUsers  Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  leads         Lead[]
  orgGmailToken OrgGmailToken?
  savedSearches SavedSearch[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  role           String   @default("AGENT")  // ADMIN | AGENT | VIEWER
  phone          String?
  title          String?
  avatarUrl      String?  @db.Text
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  /// Opt-out for the Dealcore Daily Brief. Flip to false to drop one person
  /// off the 7am send without a deploy.
  digestEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedLeads Lead[]
  notes         Note[]
  tasks         Task[]
  activities    Activity[]
  gmailToken    GmailToken?
  savedSearches SavedSearch[]
  aiCompCurations AiCompCuration[]
  pushDevices   PushDevice[]

  @@map("users")
}

/// A registered mobile device for push notifications (new leads, messages, calls).
/// One row per (user, device). apnsToken drives standard alerts; voipToken drives
/// Twilio VoIP push for incoming calls (PushKit -> CallKit). organizationId is
/// denormalized from the user so notification fan-out can be tenant-scoped without
/// a join. Dormant until the API has APNs credentials configured.
model PushDevice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  platform       String   @default("ios") // ios | android (android reserved for later)
  apnsToken      String?  // APNs device token for alert pushes
  voipToken      String?  // PushKit VoIP token for incoming-call pushes
  appVersion     String?
  deviceName     String?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, apnsToken])
  @@index([userId])
  @@index([organizationId])
  @@map("push_devices")
}

model Lead {
  id                String   @id @default(cuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  source            String
  status            String   @default("NEW")
  
  propertyAddress   String
  propertyCity      String
  propertyState     String
  propertyZip       String
  propertyType      String?
  bedrooms          Int?
  bathrooms         Float?
  sqft              Int?
  sqftOverride      Int?              // Manual override — used instead of ATTOM sqft for ARV calculations
  yearBuilt         Int?
  lotSize           Float?
  lastSaleDate      DateTime?
  lastSalePrice     Float?
  taxAssessedValue  Float?
  ownerOccupied     Boolean?
  hoaFee            Float?
  latitude          Float?
  longitude         Float?

  sellerFirstName   String
  sellerLastName    String
  sellerPhone       String
  sellerEmail       String?

  timeline          Int?
  askingPrice       Float?
  conditionLevel    String?
  distressSignals   Json?
  ownershipStatus   String?
  sellerMotivation  String?

  arv               Float?
  arvConfidence     Float?
  lastCompsDate     DateTime?
  currentArvCalculationId String?
  currentArvCalculation   AiArvCalculation? @relation("LeadCurrentArvCalculation", fields: [currentArvCalculationId], references: [id], onUpdate: NoAction, onDelete: SetNull)
  currentArvUpdatedAt     DateTime?
  compsProvider     String?  @default("reapi") // 'reapi' | 'batchdata' | 'auto' — last-used comp provider per lead
  repairCosts       Float?   // Deal-level repair cost override
  assignmentFee     Float?   // Deal-level assignment fee override
  maoPercent        Float?   // MAO % override (default 70)

  // ── Phase D: Deal Math canonical fields ──────────────────────────────────
  // Single source of truth for the active strategy + repair estimate +
  // strategy-specific inputs + computed deal numbers. Reads from these,
  // not from CompAnalysis. CompAnalysis fields are deprecated for new writes.
  dispositionStrategy        String?   // wholesale | novation | sub_to | double_close | fix_flip | concierge_listing | hold_rental | jv | other
  currentRepairEstimate      Float?
  currentRepairEstimateMethod String?  // PHOTO_ANALYSIS | QUICK_SQFT | MANUAL_BUILDER | AI_TEXT | MANUAL_OVERRIDE
  currentRepairEstimateMetadata Json?  // method-specific context (photo range, sqft tier, builder selections, AI prompt)
  currentRepairEstimateUpdatedAt DateTime?
  dealMathInputs             Json?     @default("{}") // { [strategy]: { [field]: value } }
  currentDealNumbers         Json?     // { strategy, arv, repairEstimate, inputs, outputs, computedAt }
  currentDealNumbersUpdatedAt DateTime?

  photoAnalysisResults       PhotoAnalysisResult[]

  // ── ATTOM enrichment (written by Deal Search flow) ───────────────────────
  attomId              String?   // ATTOM property ID for lookups
  attomEnrichedAt      DateTime? // when ATTOM data was last fetched
  attomAvm             Float?    // ATTOM AVM estimate
  attomAvmLow          Float?
  attomAvmHigh         Float?
  avmPoorHigh          Float?    // Condition-adjusted: distressed/AS-IS value
  avmExcellentHigh     Float?    // After-repair/renovated ARV ← TRUE ARV
  marketAssessedValue  Float?    // Market assessed value (provider-neutral)
  annualTaxAmount      Float?    // Actual annual property tax
  propertyCondition    String?   // GOOD / FAIR / POOR
  propertyQuality      String?   // EXCELLENT / GOOD / AVERAGE / FAIR / POOR
  wallType             String?   // BRICK / FRAME / STUCCO etc.
  stories              Int?      // Number of stories/levels
  basementSqft         Int?      // Basement square footage
  effectiveYearBuilt   Int?      // Renovation/effective year
  subdivision          String?   // Subdivision/neighborhood name
  coolingType          String?   // CENTRAL / EVAPORATIVE / etc.
  heatingType          String?   // FORCED AIR / BASEBOARD / etc.
  apn                  String?   // Assessor's Parcel Number
  ownerName            String?   // Owner name from assessment records

  // ── BatchData enrichment (validation phase) ──────────────────────────────
  batchdataLookupData      Json?     // Full BatchData property lookup response
  batchdataLookupFetchedAt DateTime? // When BatchData lookup was last fetched
  dataProviderConflicts    Json?     // Log of fields where REAPI and BatchData disagreed

  // ── RealEstateAPI (REAPI) enrichment ─────────────────────────────────────
  reapiId                 String?   // REAPI property ID for subsequent lookups
  reapiEnrichedAt         DateTime? // when REAPI data was last fetched
  reapiEstimatedValue     Float?    // REAPI AVM point estimate
  reapiEstimatedValueLow  Float?
  reapiEstimatedValueHigh Float?
  reapiEquity             Float?    // Estimated owner equity
  reapiMortgageData       Json?     // Current mortgage(s): lender, amount, rate, type, term, origination, lien position
  reapiSaleHistory        Json?     // Prior sales from REAPI
  reapiFeatures           Json?     // pool, garage, basement, stories, heating/cooling, condition, etc.
  reapiOwnerData          Json?     // Owner name(s), mailing address, owner-occupied, LLC flag

  // ── REAPI MLS add-on (v2/MLSDetail) ──────────────────────────────────────
  reapiMlsListingId       String?   // current/most-recent MLS listing ID
  reapiMlsNumber          String?   // board-assigned MLS number
  reapiMlsStatus          String?   // standardStatus from latest listing (Active/Pending/Sold/Cancelled/...)
  reapiMlsListPrice       Float?
  reapiMlsSoldPrice       Float?
  reapiMlsListDate        DateTime?
  reapiMlsSoldDate        DateTime?
  reapiMlsDaysOnMarket    Int?
  reapiMlsHistory         Json?     // [{ price, status, statusDate, daysOnMarket, agentName, ... }]
  reapiMlsPhotos          Json?     // [{ lowRes, midRes, highRes }]
  reapiMlsAgent           Json?     // { fullName, email, phone, mlsCode, officeName }
  reapiMlsRemarks         String?   // publicRemarks (listing description)

  // DEPRECATED: Score system being phased out. Do not extend.
  // Replacement strategy TBD — likely a derived freshness/momentum metric.
  // See docs/build-prompts/README.md.
  challengeScore    Int      @default(0)
  authorityScore    Int      @default(0)
  moneyScore        Int      @default(0)
  priorityScore     Int      @default(0)
  totalScore        Int      @default(0)
  scoreBand         String   @default("DEAD_COLD")
  abcdFit           String?
  scoringRationale  String?
  lastScoredAt      DateTime?
  
  assignedToUserId  String?
  assignedTo        User?    @relation(fields: [assignedToUserId], references: [id])
  assignedStage     String?
  assignedAt        DateTime?
  tags              Json?
  
  doNotContact      Boolean  @default(false)
  unsubscribedAt    DateTime?
  autoRespond       Boolean  @default(true)
  autoResponseCount Int      @default(0)
  autoResponseDate  DateTime?

  campPriorityComplete  Boolean @default(false)
  campMoneyComplete     Boolean @default(false)
  campChallengeComplete Boolean @default(false)
  campAuthorityComplete Boolean @default(false)

  // Set when the AI sends the deal-fit expectations message (60-70% of ARV
  // explanation, manufactured/leased-land fit talk). Used to gate the post-CAMP
  // closing handoff so we don't wrap up before expectations are surfaced.
  expectationsSetAt     DateTime?

  // Set when the AI asks the seller to text photos of the property. Gates the
  // post-CAMP handoff: we ask for photos first, then close on the next reply,
  // so the conversation doesn't end the moment the last CAMP field lands.
  photosRequestedAt     DateTime?

  // Last time an outbound SMS to this lead carried the compliance footer
  // (sender ID + opt-out). Drives "first message only" and the optional
  // periodic re-send interval in Settings > Messaging Compliance.
  complianceFooterSentAt DateTime?

  // Deal tier: 1 = contract now, 2 = opportunity, 3 = dead/no go
  tier                  Int?

  sourceMetadata    Json?
  primaryPhoto      String?
  photos            Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Pipeline tracking
  stageChangedAt    DateTime  @default(now())
  daysInStage       Int       @default(0)
  lastTouchedAt     DateTime  @default(now())
  touchCount        Int       @default(0)
  /// Numbers and email addresses that have been tried and do not reach this
  /// person: disconnected, wrong party, hard bounce. Shape:
  /// `{ phones: string[], emails: string[] }`.
  ///
  /// Stored as VALUES, never as slot positions. A skip trace rewrites phone2
  /// through phone4 in whatever order the vendor returned them, so a flag
  /// pinned to "slot 3" would silently start describing a different number.
  ///
  /// Deliberately separate from the per-number DNC flags. "We are not allowed
  /// to call this" and "this number does not work" are different facts with
  /// different remedies, and collapsing them would either hide a compliance
  /// problem or bury a good number under one.
  badContacts       Json?
  aiRecommendation  String?

  // Unified inbox: denormalized last-message summary + thread state (team-level)
  lastMessageAt        DateTime?
  lastMessagePreview   String?
  lastMessageDirection String?
  threadUnread         Boolean  @default(false)
  threadStarred        Boolean  @default(false)

  // Hot-leads dismissal. Set when someone clears a lead off the dashboard's
  // Hot leads card; the lead keeps its score band, it just stops surfacing
  // there. Cleared (null) to bring it back.
  hotDismissedAt       DateTime?

  // Hero strip AI insight (one-line lead-state summary, cached by state fingerprint)
  aiInsight             String?
  aiInsightGeneratedAt  DateTime?
  aiInsightState        String?   // fingerprint of (stage, tier, lastMessageId, offerCount, campCompleteness)

  // Alert dismissals for contradiction detector (keyed by ruleId → fingerprint)
  alertDismissals       Json?     // { [ruleId: string]: { fingerprint: string, dismissedAt: string } }

  // ── Disposition v2: post-acquisition tracking ────────────────────────────
  acquiredDate     DateTime?  // denormalized from contract.acquiredAt
  soldDate         DateTime?  // denormalized from finalSale.closedAt
  realizedProfit   Float?     // cached output of ProfitCalculationService.recalculate
  profitBucket     String?    @default("potential") // potential | expected | realized
  targetSalePrice  Float?     // disposition target; distinct from arv (comp valuation)

  messages          Message[]
  emails            Email[]
  comps             Comp[]
  compAnalyses      CompAnalysis[]
  tasks             Task[]
  notes             Note[]
  activities        Activity[]
  contract          Contract?
  offers            Offer[]
  dripSequence      DripSequence?
  callLogs          CallLog[]
  campaignEnrollments CampaignEnrollment[]
  dealShares          DealShare[]
  dispositionPlan     DispositionPlan?
  dispositionCosts    DispositionCost[]
  finalSale           FinalSale?
  aiCompCurations     AiCompCuration[]
  aiArvCalculations   AiArvCalculation[] @relation("LeadAiArvCalculations")
  foreclosureDetail   ForeclosureDetail?
  probateDetail       ProbateDetail?
  taxSaleDetail       TaxSaleDetail?
  surplusDetail       SurplusDetail?
  foreclosureDocuments ForeclosureDocument[]
  foreclosureFilings   ForeclosureFiling[]
  foreclosureSignals   ForeclosureSignal[]

  @@index([organizationId, tier])
  @@index([organizationId, status])
  @@index([organizationId, totalScore])
  @@index([organizationId, createdAt])
  @@index([organizationId, lastTouchedAt])
  @@index([organizationId, propertyState])
  @@index([organizationId, scoreBand])
  @@index([organizationId, source])
  @@index([organizationId, profitBucket, status])
  @@index([organizationId, soldDate])
  @@index([organizationId, stageChangedAt])
  @@index([organizationId, lastMessageAt])
  @@map("leads")
}

// Foreclosure-specific detail, 1:1 with a Lead whose source = FORECLOSURE.
// Holds the pre-foreclosure notice facts + skip-trace + derived scoring that
// power the Foreclosures pipeline tab. Ingested from the Mecklenburg Times RSS
// feed, uploaded eCourts PDFs, or the initial tracker-sheet import.
model ForeclosureDetail {
  id             String   @id @default(cuid())
  leadId         String   @unique
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?

  // Idempotent-ingestion keys. dedupeUid = "caseNumber|address|saleDate" (from
  // the offline tracker's uidOf). noticeId = the source notice identifier
  // (Meck Times detail= number, or eCourts file id).
  dedupeUid      String
  noticeId       String?

  // Notice
  noticeType     String?  // ForeclosureNoticeType
  noticeUrl      String?
  caseNumber     String?
  county         String?
  trustee        String?
  rawSnippet     String?
  sourceKind     String?  // ForeclosureSourceKind

  // Facts
  saleDate       DateTime?
  hearingDate    DateTime?
  loanDate       DateTime?
  loanAmount     Float?
  assessedValue  Float?

  // Derived / workflow
  priority       String?  @default("LOW") // ForeclosurePriority
  leadScore      Int?     @default(0)
  equityPct      Float?
  equitySpread   Float?
  // Set by the deterministic rules engine from the matched lender profile.
  loanType       String?  // ForeclosureLoanType
  lenderName     String?
  // False for a HECM, whose recorded principal is a multiple of the maximum
  // claim amount and so overstates the debt. When false, equityPct and
  // equitySpread above are deliberately left null rather than computed wrong.
  debtFigureReliable Boolean @default(true)
  workStatus     String?  @default("NOT_CONTACTED") // ForeclosureWorkStatus
  doNotCall      Boolean  @default(false)
  callNotes      String?

  // Weekly touch tracking (mirrors the offline tracker): touchDays holds this
  // week's mon-fri checkmarks, touchWeek is the ISO week key they belong to,
  // touchCount accumulates checks from prior (rolled-over) weeks.
  touchDays      Json?
  touchWeek      String?
  touchCount     Int      @default(0)

  // Owner / skip trace
  countyOwner    String?
  ownerOccupied  String?  // 'Y' | 'N' | null
  mailingAddress String?
  mailCity       String?
  mailState      String?
  mailZip        String?
  skipStatus     String?
  // Contact numbers/emails. Lead.sellerPhone holds phone1 and Lead.sellerEmail
  // holds email1; the rest live here so skip trace can attach up to 4 phones
  // and 2 emails per lead.
  phone2         String?
  phone3         String?
  phone4         String?
  phone1Type     String?  // 'Mobile' | 'Landline' | null
  phone2Type     String?
  phone3Type     String?
  phone4Type     String?
  email2         String?

  /// Normalized "same property" key (see addressKeyOf). Lets a re-filed notice
  /// carrying no case number find the lead it belongs to instead of forking a
  /// second one when its sale date moves.
  addressKey     String?

  // External links
  parcelId       String?
  parcelUrl      String?
  parcelType     String?  // 'exact' | 'county' | 'search'
  parcelLabel    String?
  zillowUrl      String?
  realtorQuery   String?
  realtorZip     String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, dedupeUid])
  @@unique([organizationId, noticeId])
  @@index([organizationId, priority])
  @@index([organizationId, saleDate])
  @@index([organizationId, workStatus])
  @@index([organizationId, addressKey])
  // Inbound texts and calls arrive with only a number, and a seller may answer
  // from any of the four. These make that reverse lookup an index hit.
  @@index([phone2])
  @@index([phone3])
  @@index([phone4])
  @@map("foreclosure_details")
}

/// Probate-specific facts for a Lead with source = PROBATE. Deliberately
/// thinner than ForeclosureDetail: a probate lead has no auction clock, no
/// lender, and no equity math to run, so what is worth keeping is the estate
/// (case, decedent, how long since death), the heir we are actually going to
/// talk to, and the ranking the source list arrived with.
model ProbateDetail {
  id             String   @id @default(cuid())
  leadId         String   @unique
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?

  // Idempotent-ingestion key: "caseNumber|address". The case number alone
  // cannot be it, because one estate routinely holds several properties and
  // each is its own lead; the address alone cannot be it either, because the
  // same house can reappear under a second estate.
  dedupeUid      String
  // Label for the file/list this row came in on, so a bad batch can be found
  // and pulled without guessing at createdAt windows.
  importBatch    String?

  // Estate / case
  caseNumber     String?
  caseFiledDate  DateTime?
  county         String?
  deceasedName   String?
  // Months between the death and when the list was built. The 3-9 month band
  // is the window the source list scores hardest on.
  monthsSinceDeath Float?

  // Heir / petitioner: the living person the Lead's seller fields describe.
  // heirCity is where they live. When that is not the property's city the
  // estate is being handled from a distance, which is the absentee signal
  // this list ranks on.
  heirCity       String?
  absenteeHeir   Boolean  @default(false)

  // Ranking carried over from the source list, kept so the reason a lead is
  // near the top survives the import and can be shown back on the lead.
  consensusRank   Int?
  consensusScore  Float?
  consensusTier   String?
  agreement       String?
  eslPriority     Float?
  eslTier         String?
  motivationScore Float?
  motivationTier  String?
  whyThisLead     String?
  estValue        Float?

  // Extra contacts. Lead.sellerPhone and Lead.sellerEmail hold the best of
  // each; the runners-up live here. moreOnFile records what the source list
  // says it holds beyond the two it handed over.
  phone1Type     String?
  phone2         String?
  phone2Type     String?
  email2         String?
  moreOnFile     String?

  // One heir often inherits several properties, so several probate leads can
  // share a phone and an email. contactKey groups them; primaryContact marks
  // the single lead in each group that a drip should enroll, so a campaign
  // does not text one grieving person sixteen times in a week.
  contactKey     String?
  primaryContact Boolean  @default(true)

  // Workflow
  workStatus     String?  @default("NOT_CONTACTED") // ProbateWorkStatus
  doNotCall      Boolean  @default(false)
  callNotes      String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, dedupeUid])
  @@index([organizationId, consensusTier])
  @@index([organizationId, workStatus])
  @@index([organizationId, contactKey])
  // Reverse lookup for an inbound message from the heir's second number.
  @@index([phone2])
  @@map("probate_details")
}

/// Tax-sale-specific facts for a Lead with source = TAX_SALE. A delinquent tax
/// foreclosure is not a mortgage foreclosure: there is no lender debt to net
/// against, the number that decides the deal is the REDEMPTION PAYOFF (taxes
/// plus interest, fees and costs), and the owner can pay it any time before the
/// court confirms the sale, which withdraws the property and kills the lead.
/// So redemptionAmount is a first-class column, not something derived later.
model TaxSaleDetail {
  id             String  @id @default(cuid())
  leadId         String  @unique
  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?

  /// Idempotent-ingestion key: "fileNumber|address". The file number alone is
  /// not enough because one judicial action can cover several parcels, and the
  /// address alone is not enough because a property that redeems and falls
  /// delinquent again comes back under a new file.
  dedupeUid   String
  importBatch String?

  // ── The filing ────────────────────────────────────────────────────────────
  fileNumber String?
  method     String? // TaxSaleMethod: IN_REM | JUDICIAL
  /// "105-375" for in rem, "105-374" for judicial. Stored rather than derived
  /// from method so a county that files unusually is recorded as it filed.
  statute    String?
  deedType   String? // "Sheriff's Deed" | "Commissioner's Deed"
  filedBy    String? // county attorney or the outside firm handling it
  county     String?
  parcelId   String?

  // ── Property and owner ────────────────────────────────────────────────────
  countyOwner  String? // owner exactly as the county lists it
  propertyType String?
  acreage      Float?
  ownedSince   String?
  occupancy    String? @default("UNKNOWN") // TaxSaleOccupancy

  // ── Clocks ────────────────────────────────────────────────────────────────
  saleDate      DateTime?
  /// End of the 10-day upset bid window that runs from the report of sale.
  upsetDeadline DateTime?

  // ── Money ─────────────────────────────────────────────────────────────────
  assessedValue    Float?
  taxesOwed        Float?
  /// Everything the owner must pay to redeem: taxes plus interest, fees, and
  /// costs. Always >= taxesOwed; the difference is what the card shows as
  /// "interest, fees, and costs" in the payoff waterfall.
  redemptionAmount Float?
  openingBid       Float?
  currentBid       Float?
  depositPct       Float?  @default(20)
  /// The tax years actually behind, e.g. [2019, 2020, 2021]. Length is the
  /// "years delinquent" figure the board filters on.
  delinquentYears  Json?
  /// City taxes are owed on top of the county's, which raises the payoff.
  cityTaxes        Boolean @default(false)
  /// A lender on title usually redeems to protect its own lien, which is the
  /// single biggest reason a tax sale lead goes nowhere.
  hasMortgage      Boolean @default(false)
  /// An IRS lien carries a 120-day federal right of redemption AFTER the sale.
  hasIrsLien       Boolean @default(false)

  // ── Derived ───────────────────────────────────────────────────────────────
  stage        String? @default("JUDGMENT_DOCKETED") // TaxSaleStage
  priority     String? @default("LOW") // ForeclosurePriority
  leadScore    Int     @default(0)
  equityPct    Float?
  equitySpread Float?

  // ── Working the lead ──────────────────────────────────────────────────────
  workStatus String? @default("NOT_CONTACTED") // TaxSaleWorkStatus
  doNotCall  Boolean @default(false)
  callNotes  String?
  /// Free-text card chips: "Owner-occupied", "Title complexity", "Estate",
  /// "Heirs required". Descriptive, and each doubles as a board filter.
  tags       Json?
  /// { title, owner, occupancy, drive } - the workup checklist that gates
  /// outreach. All four must be ticked before the board will queue a call.
  workup     Json?
  touchDays  Json?
  touchWeek  String?
  touchCount Int     @default(0)

  // ── Contacts and DNC ──────────────────────────────────────────────────────
  // Lead.sellerPhone holds phone1 and Lead.sellerEmail holds email1; the rest
  // live here so a skip trace can attach up to 4 phones and 2 emails.
  phone2        String?
  phone3        String?
  phone4        String?
  phone1Type    String?
  phone2Type    String?
  phone3Type    String?
  phone4Type    String?
  email2        String?
  /// Per-number DncRegistry ('federal' | 'state' | 'litigator'), null when the
  /// number came back clean. Registered numbers are roughly a $500-$1,500
  /// problem per call, trebled if willful, so this is stored per number rather
  /// than collapsed into one flag on the lead.
  phone1Dnc     String?
  phone2Dnc     String?
  phone3Dnc     String?
  phone4Dnc     String?
  /// When the numbers were last run against the registries. A scrub older than
  /// 31 days does not count as scrubbed, because people register in between.
  dncScrubbedAt DateTime?

  // ── External links ────────────────────────────────────────────────────────
  parcelUrl    String?
  zillowUrl    String?
  realtorQuery String?
  realtorZip   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeUid])
  @@index([organizationId, priority])
  @@index([organizationId, saleDate])
  @@index([organizationId, stage])
  @@index([organizationId, workStatus])
  @@index([organizationId, county])
  // An inbound text or call arrives with only a number and the owner may use
  // any of the four, so these make that reverse lookup an index hit.
  @@index([phone2])
  @@index([phone3])
  @@index([phone4])
  @@map("tax_sale_details")
}

/// Surplus-funds facts for a Lead with source = SURPLUS. Florida only, and
/// structurally unlike every other pipeline here: the lead is a FORMER owner
/// with money already sitting at a clerk, not a homeowner facing a sale. There
/// is no property to buy. What is being worked is a claim, and whether we can
/// be paid for filing it is a compliance question that gates the contract.
model SurplusDetail {
  id             String  @id @default(cuid())
  leadId         String  @unique
  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId String?

  /// Idempotent-ingestion key: "county|caseNumber|claimant". A single sale can
  /// produce several claimants against one surplus (an owner and two
  /// lienholders), and each is its own lead.
  dedupeUid   String
  importBatch String?

  // ── The case ──────────────────────────────────────────────────────────────
  county     String?
  caseNumber String?
  parcelId   String?

  // ── The claimant ──────────────────────────────────────────────────────────
  claimantType  String? @default("previous_owner") // SurplusClaimantType
  /// Either flag routes the lead onto the heir/estate drip and drops it out of
  /// Tier A, because an estate claim needs letters and a death certificate
  /// before it can be filed at all.
  deceased      Boolean @default(false)
  heirsRequired Boolean @default(false)
  /// Informational, not a block: a competing lien does not stop outreach, but
  /// the payout may land under the posted surplus.
  competingLien Boolean @default(false)

  // ── The regime ────────────────────────────────────────────────────────────
  // These two fields together select the compliance rule, which sets the fee
  // cap, whether a licensed representative is required, and the claim window.
  surplusType  String? @default("tax_deed") // SurplusType
  fundLocation String? @default("clerk") // SurplusFundLocation

  // ── Clocks ────────────────────────────────────────────────────────────────
  saleDate            DateTime?
  salePrice           Float?
  /// The claim window runs from the MAILED NOTICE of surplus, not the sale.
  noticeDate          DateTime?
  /// Until the notice date is confirmed with the clerk the countdown is a
  /// guess, and the card says so rather than showing a confident number.
  noticeConfirmed     Boolean   @default(false)
  /// Starts the separate 60-day clock for filing the assignment.
  certOfDisbursements DateTime?

  // ── Money ─────────────────────────────────────────────────────────────────
  grossSurplus Float?
  /// [{ type, holder, amount, priority, governmental }]. Governmental units
  /// other than federal or ad valorem are paid before nongovernmental
  /// claimants, so they come off the top of the waterfall regardless of
  /// recording order. Net to claimant is gross minus all of these.
  liens        Json?

  // ── The arrangement ───────────────────────────────────────────────────────
  arrangement        String? @default("assignment") // assignment | limited_poa
  /// Measured against TOTAL consideration, not a line item labelled "fee",
  /// because FS 45.033(3)(d) reaches anything paid or payable, earned or
  /// expected to be earned.
  totalConsideration Float?  @default(0)
  /// Required once funds escheat: Chapter 717 needs a representative
  /// registered with Florida DFS, and without one the contract is blocked.
  licensedRepId      String?

  // ── Pipeline ──────────────────────────────────────────────────────────────
  stage String? @default("New") // SurplusStage
  /// Cached band so the board can sort and count without recomputing over
  /// every row. Derived from gross surplus, deceased/heirs, competing lien.
  tier  String? @default("U") // SurplusTier

  // ── Qualification gate ────────────────────────────────────────────────────
  // All three must be true before the stage can advance to Agreement Signed.
  // A hard gate, not a warning, so a stage change cannot skip past it.
  entitlementVerified Boolean @default(false)
  titleSearchComplete Boolean @default(false)
  /// { financial, noAttorneyNeeded, allConsideration } - the disclosures the
  /// governing rule requires in the contract. Any missing one blocks the send.
  disclosures         Json?
  /// { claimForm, photoId, proofOwnership, w9, feeAgreement, titleSearch,
  /// deathCert, letters } - what has actually been collected.
  docs                Json?

  // ── Where the money stands ────────────────────────────────────────────────
  /// SurplusClaimStatus. A different axis from `tier`, which bands dollars.
  /// Read off the case document list, never off the posted balance: Duval case
  /// 2025-0774TD carries three Surplus Distribution filings and the search grid
  /// still shows the full $27,929.98.
  claimStatus     String? @default("unknown")
  /// The surplus the clerk stated in the mailed notice. Differs from
  /// grossSurplus, which is what is left today: Duval 2026-0004TD was noticed at
  /// $22,774.71 and now posts $22,421.18. The notice figure is what the claimant
  /// was told they are owed and is the number to use in conversation; the
  /// current balance is what to underwrite against.
  surplusAtNotice Float?
  /// Verdict from the clerk's own returned-mail filings: 'delivered',
  /// 'undeliverable', 'unclaimed', 'mixed'. UNCLAIMED means delivery was
  /// attempted and notices were left, so the address is live and worth a call.
  /// Undeliverable means it is not. Collapsing the two loses real leads.
  mailVerdict     String?
  /// Every document on the case, newest last: [{ title, kind, docId, url }].
  /// Persisted so a classifier change can be re-run over history without
  /// re-fetching the county, which is the expensive and rate-limited half.
  claimLedger     Json?

  // ── The owner's own address ───────────────────────────────────────────────
  /// Where the clerk actually MAILED the Notice of Surplus Funds, read off the
  /// notice itself. This is the skip-trace target and it is usually NOT the
  /// property: Duval case 2025-0023TD sold a vacant lot in Jacksonville and
  /// noticed Myrtis Griffin at 72 Smith Drive, Hartford, CT. Tracing the
  /// property address there returns whoever lives on the parcel now, which is
  /// the whole reason the first live run came back six strangers.
  noticeRecipient    String?
  ownerMailingStreet String?
  ownerMailingCity   String?
  ownerMailingState  String?
  ownerMailingZip    String?
  /// Which county document the mailing address came from, for audit.
  ownerAddressSource String?

  // ── Provenance ────────────────────────────────────────────────────────────
  /// 'duval_taxdeed' | 'realtdm' | 'import' | 'manual'. Counties name things
  /// differently and a classifier carried across sources has been wrong every
  /// time, so the source travels with the row.
  sourceSystem String?
  /// The county's own case id, for re-fetch. Duval: the integer behind
  /// /Home/Details?id=NNN.
  sourceCaseId String?
  sourceUrl    String?
  lastPolledAt DateTime?

  // ── Working the lead ──────────────────────────────────────────────────────
  doNotCall  Boolean @default(false)
  callNotes  String?
  touchDays  Json?
  touchWeek  String?
  touchCount Int     @default(0)
  /// When one of us mailed a letter to this claimant, and the address on the
  /// envelope. One letter per claimant for now; the Notes tab keeps the
  /// history. A mailed claimant with no callable number sits in the Letter
  /// sent queue instead of trace or name search, so nobody chases an address
  /// that has already been written to. A callable number still wins: a call
  /// is a different channel and the letter does not make it less worth dialling.
  letterMailedAt DateTime?
  letterMailedTo String?

  // ── Contacts ──────────────────────────────────────────────────────────────
  phone2     String?
  phone3     String?
  phone4     String?
  phone1Type String?
  phone2Type String?
  phone3Type String?
  phone4Type String?
  email2     String?
  /// Per-number DncRegistry ('federal' | 'state' | 'litigator'), null when the
  /// number came back clean. Skip-traced surplus lists routinely come back with
  /// half their numbers already on a registry, so the flag has to survive
  /// import: a number shown without it is a number somebody will dial.
  phone1Dnc  String?
  phone2Dnc  String?
  phone3Dnc  String?
  phone4Dnc  String?
  /// When the numbers were last run against the registries.
  dncScrubbedAt DateTime?
  /// Set when a skip trace came back with contacts that do NOT belong to the
  /// claimant. The contacts are discarded rather than stored, and this records
  /// why the lead has none, so nobody re-runs the same trace expecting a hit.
  contactMismatch Boolean @default(false)
  /// The name the trace actually returned, kept only when it was rejected as a
  /// mismatch, so the rejection can be audited rather than just trusted.
  mismatchedName  String?

  /// When a skip trace was last ATTEMPTED for this claimant, whatever came
  /// back. NULL means never attempted, which is the state most rows are in:
  /// the nightly county poll ingests and classifies but never traces, because
  /// every submission is billed. "Never tried" and "tried and found nothing"
  /// need different next actions and were previously indistinguishable, so the
  /// panel was read as a failure when nothing had run at all.
  tracedAt        DateTime?
  /// Outcome of that attempt: 'matched' | 'relative' | 'unverified' |
  /// 'mismatch' | 'no_person' | 'no_contact' | 'skipped'. Per CLAIMANT, not per
  /// address: one submission serves every claimant at an address and they
  /// routinely end differently, one matched and one a stranger.
  traceOutcome    String?
  /// The sentence behind the outcome, including the refusal reason when we
  /// declined to submit at all.
  traceDetail     String?

  /// Living people who inherited this claimant's interest. Populated from a
  /// probate filing somebody read; never inferred.
  heirs SurplusHeir[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, dedupeUid])
  @@index([organizationId, stage])
  @@index([organizationId, tier])
  @@index([organizationId, county])
  @@index([organizationId, noticeDate])
  @@index([organizationId, grossSurplus])
  @@index([organizationId, claimStatus])
  @@index([phone2])
  @@index([phone3])
  @@index([phone4])
  @@map("surplus_details")
}

/// One uploaded filing from a foreclosure case file. Deliberately stores the
/// extracted TEXT and not the PDF: sampled Mecklenburg filings run 3-4 MB each
/// (scanned cover pages at full resolution) against ~13 KB of text, so keeping
/// bytes would cost gigabytes a year for something no downstream step reads.
/// Extraction and signal passes both consume rawText, so re-running either at a
/// bumped version needs nothing from disk. fileKey is reserved for a later move
/// to object storage; nothing writes it today.
///
/// Documents key on caseNumber, not leadId, because one case accumulates
/// several filings over its life. leadId is nullable so a filing can land
/// before its lead exists.
model ForeclosureDocument {
  id               String   @id @default(cuid())
  leadId           String?
  lead             Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId   String?

  // sha256 of the uploaded bytes. Re-uploading the same file is a no-op; the
  // same file arriving for a different org is not (hence the compound unique).
  fileHash         String
  originalFilename String?
  fileSizeBytes    Int?
  fileKey          String?

  caseNumber       String?
  county           String?
  documentType     String?  // ForeclosureDocumentType
  noticeUrl        String?

  pageCount        Int?
  extractionMethod String?  // ForeclosureExtractionMethod
  rawText          String?  @db.Text
  // chars / pageCount. Under ~400 means the text layer is missing and the file
  // is image-only; those are flagged for manual entry rather than OCR'd.
  charsPerPage     Float?

  uploadedAt       DateTime  @default(now())
  extractedAt      DateTime?
  extractionError  String?

  filing           ForeclosureFiling?

  @@unique([organizationId, fileHash])
  @@index([organizationId, caseNumber])
  @@index([leadId, uploadedAt(sort: Desc)])
  @@map("foreclosure_documents")
}

/// The ~25 structured fields pulled out of one filing's text by the extractor.
/// One row per document; re-extracting at a bumped extractionVersion updates
/// the row in place rather than adding a new one.
///
/// verifiedFields is the contract with the user: any field they correct by hand
/// is listed there and no re-extraction ever overwrites it. fieldConfidence
/// carries the model's 0-1 score per field so the review panel can flag the
/// shaky ones.
///
/// hearingAt and saleAt are true instants. NC filings state Eastern wall-clock
/// time with no zone ("September 8, 2026 at 2:00PM"), so the model returns the
/// local date and time separately and courtLocalToUtc resolves the offset.
model ForeclosureFiling {
  id                    String   @id @default(cuid())
  documentId            String   @unique
  document              ForeclosureDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  leadId                String?
  lead                  Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId        String?
  extractionVersion     Int      @default(1)

  // Case
  caseNumber            String?
  county                String?
  filedAt               DateTime?
  submittedAt           DateTime?

  // Parties
  recordOwnerNames      String[]
  substituteTrustee     String?
  trusteeAttorney       String?
  trusteeAttorneyBarNo  String?
  trusteeFirm           String?
  trusteeFirmAddress    String?
  trusteeFirmPhone      String?
  trusteeFileNumber     String?
  holderName            String?
  holderAddress         String?
  // The originator often appears only here, as "MERS as nominee for X". It is
  // what identifies a HECM when the current holder does not.
  originalBeneficiary   String?

  // Loan
  dotDate               DateTime?
  dotBook               String?
  dotPage               String?
  originalPrincipal     Float?

  // Property
  propertyAddress       String?
  // High-value join key for the county parcel load in 019. Distinct from
  // ForeclosureDetail.parcelId, which comes from the NC OneMap skip trace.
  taxParcelId           String?

  // Timeline
  hearingAt             DateTime?
  hearingMethod         String?
  saleAt                DateTime?

  // Meta
  fieldConfidence       Json?
  verifiedByUserAt      DateTime?
  verifiedFields        String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  signals               ForeclosureSignal[]

  @@index([organizationId, caseNumber])
  @@index([leadId])
  @@map("foreclosure_filings")
}

/// One typed, actionable flag derived from a filing's extracted facts plus the
/// deterministic rules output. Not prose: a code, a severity, one clause, the
/// field names it rests on, and suggested next steps.
///
/// analysisVersion is separate from the filing's extractionVersion so the
/// signals prompt can be improved and re-run without re-extracting anything.
///
/// evidence is never empty. A signal that cannot name a field it rests on is
/// dropped before it reaches this table.
model ForeclosureSignal {
  id                 String   @id @default(cuid())
  filingId           String
  filing             ForeclosureFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  leadId             String?
  lead               Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organizationId     String?
  analysisVersion    Int      @default(1)

  signalCode         String
  severity           String   // 'info' | 'notable' | 'critical'
  headline           String
  evidence           String[]
  recommendedActions String[]
  /// Which recommended actions the user has ticked off, by action name.
  completedActions   String[]
  generatedAt        DateTime @default(now())

  @@unique([filingId, signalCode])
  @@index([leadId, severity])
  @@index([organizationId, signalCode])
  @@map("foreclosure_signals")
}

/// Lender name patterns that classify what kind of debt is being foreclosed.
/// This is a lookup table rather than a model inference on purpose: identifying
/// a reverse mortgage is the highest-value call in the pipeline, so it has to
/// be reliable, auditable, and editable by the team as new filing patterns turn
/// up. Grows with every unfamiliar holder the team sees.
///
/// organizationId null means a shared, seeded row visible to every org; a
/// non-null value is an org's own addition.
model LenderProfile {
  id             String   @id @default(cuid())
  organizationId String?
  matchPattern   String
  /// 'substring' compares with whitespace and punctuation stripped from both
  /// sides, so it still matches the space-stripped text of a scanned page.
  /// 'regex' runs against space-normalized text, for short acronyms that need
  /// word boundaries (a bare "AAG" as a substring would over-match).
  matchType      String   @default("substring")
  lenderName     String
  loanType       String
  servicerType   String?
  notes          String?
  /// Higher wins when several patterns match; ties break on longer pattern.
  priority       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, matchPattern])
  @@index([organizationId, active])
  @@map("lender_profiles")
}

/// Per-user read state for a lead's conversation. `viewedAt` is the last time
/// this user opened the thread, so a thread reads as unread for one teammate
/// while another has already caught up. Also orders the inbox "Recent" filter.
model ConversationView {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  viewedAt  DateTime @default(now())

  @@unique([userId, leadId])
  @@index([userId, viewedAt])
  // Joined lead-side when computing per-user unread across a page of threads.
  @@index([leadId])
  @@map("conversation_views")
}

model Message {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction   String
  status      String    @default("PENDING")
  body        String
  mediaUrls   Json?     // MMS attachments: array of { url, thumbnailUrl } (base64 data URIs), null for plain SMS
  from        String
  to          String
  // Twilio MessageSid. Not @unique: legacy rows from the previous provider are
  // not guaranteed unique, and simulated/blocked sends reuse synthetic ids.
  twilioSid   String?
  sentByUserId String?  // agent who manually sent an outbound text; null = AI/system/inbound
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("messages")
}

model Comp {
  id              String        @id @default(cuid())
  // For ad-hoc analyses (no Lead), leadId is null and propertyLookupId points to
  // the PropertyLookup parent. Exactly one of leadId / propertyLookupId is set.
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyLookupId String?
  propertyLookup   PropertyLookup? @relation(fields: [propertyLookupId], references: [id], onDelete: Cascade)
  analysisId      String?
  analysis        CompAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  address         String
  distance        Float
  soldPrice       Float
  soldDate        DateTime
  daysOnMarket    Int?
  bedrooms        Int?
  bathrooms       Float?
  sqft            Int?
  lotSize         Float?
  yearBuilt       Int?
  hasPool         Boolean       @default(false)
  hasGarage       Boolean       @default(false)
  isRenovated     Boolean       @default(false)
  propertyType    String?
  hoaFees         Float?
  schoolDistrict  String?
  photoUrl        String?
  sourceUrl       String?
  apn             String?
  source          String        @default("manual") // 'manual' | 'reapi' | 'batchdata' | 'chatarv' | 'placeholder'
  correlation     Float?
  latitude        Float?
  longitude       Float?
  features        Json?
  notes           String?
  similarityScore Int?
  selected        Boolean       @default(true)
  adjustmentAmount Float?
  adjustedPrice   Float?
  adjustmentNotes  String?
  createdAt       DateTime      @default(now())

  @@map("comps")
}

model CompAnalysis {
  id                String   @id @default(cuid())
  // For ad-hoc analyses, leadId is null and propertyLookupId is set. A DB
  // CHECK constraint enforces exactly-one parent (see the matching migration).
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyLookupId  String?
  propertyLookup    PropertyLookup? @relation(fields: [propertyLookupId], references: [id], onDelete: Cascade)
  mode              String   @default("ARV")
  maxDistance        Float    @default(3)
  timeFrameMonths   Int      @default(12)
  propertyStatus    Json     @default("[\"Sold\"]")
  propertyType      String   @default("Auto")
  confidenceScore   Int      @default(0)
  aiSummary         String?  @db.Text
  aiAssessment      String?  @db.Text  // Detailed wholesaler assessment (comp pool, market, deal viability)
  photoAnalysis     String?  @db.Text  // Room-by-room assessment from photo upload
  photoRepairLow    Int?               // Photo-based repair estimate low
  photoRepairHigh   Int?               // Photo-based repair estimate high
  arvEstimate       Float?
  arvLow            Float?
  arvHigh           Float?
  arvMethod         String   @default("average")
  avgAdjustment     Float?
  pricePerSqft      Float?
  medianPricePerSqft Float?
  comparableSalesValue Float?
  // AI-adjusted ARV (input #2 to the blended ARV — input #1 is comparableSalesValue)
  aiArvEstimate     Float?
  aiArvLow          Float?
  aiArvHigh         Float?
  aiConfidence      Float?   // 0-100, matches confidenceScore scale
  adjustmentsEnabled Boolean @default(true)
  adjustmentConfig  Json?
  repairCosts       Float?
  repairFinishLevel String?
  repairNotes       String?  @db.Text
  repairItems       Json?
  dealType          String   @default("wholesale")
  assignmentFee     Float    @default(15000)
  maoPercent        Float    @default(70)
  savedToLead       Boolean  @default(false)

  // ── Three-model valuation ─────────────────────────────────────────────────
  costApproachValue     Float?   // Cost approach estimated value
  costApproachLandValue Float?   // Land value component
  costApproachBuildCost Float?   // Replacement build cost component
  costApproachDepreciation Float? // Depreciation applied
  incomeApproachValue   Float?   // Income/rental approach estimated value
  marketRent            Float?   // Market rent used in income approach
  marketRentEstimated   Boolean  @default(false)  // true = system-estimated (sqft-based), false = user-provided
  grossRentMultiplier   Float?   // GRM used (8-14 typical)
  triangulatedArv       Float?   // Final weighted triangulated value
  triangulatedArvLow    Float?
  triangulatedArvHigh   Float?
  methodsUsed           Json?    // Which valuation methods contributed
  methodDivergence      Float?   // % spread between highest and lowest method value
  neighborhoodCeiling   Float?   // Top 3 comp average as ceiling reference
  neighborhoodCeilingBreached Boolean @default(false)
  confidenceTier        String?  // "High" | "Medium" | "Low"

  // Phase 2: Risk flags and adjustments
  functionalObsolescenceAdj   Float?
  functionalObsolescenceNotes String?  @db.Text
  buyerPoolReduction          Float?
  buyerPoolNotes              String?  @db.Text
  landUtilityReduction        Float?
  landUtilityNotes            String?  @db.Text
  riskAdjustedArv             Float?
  riskFlags                   Json?
  sellerMotivationTier        String?
  sellerMotivationMaoPercent  Float?
  conditionTier               String?
  repairCostLow               Float?
  repairCostHigh              Float?
  negotiationRangeLow         Float?
  negotiationRangeHigh        Float?

  // Deal intelligence: full investor reasoning (market velocity, $/sqft anchoring,
  // multi-scenario exits, lot value, seller pitch)
  dealIntelligence  String?  @db.Text

  // ── PropGPT (REAPI AI-powered property analysis) ─────────────────────────
  propGptAnalysis   String?   @db.Text // Raw markdown/text response from PropGPT
  propGptArv        Float?             // Parsed ARV point estimate (best-effort regex)
  propGptArvLow     Float?
  propGptArvHigh    Float?
  propGptConfidence Float?             // 0-100
  propGptFetchedAt  DateTime?
  propGptModel      String?            // e.g. "gpt-4o"

  comps             Comp[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([leadId])
  @@index([propertyLookupId])
  @@map("comp_analyses")
}

// Ad-hoc property analyses (no Lead). Lets the user run the comping pipeline
// against any address and keep a searchable history of past lookups.
model PropertyLookup {
  id            String   @id @default(cuid())
  address       String
  city          String?
  state         String?
  zip           String?
  propertyType  String?
  bedrooms      Int?
  bathrooms     Float?
  sqft          Int?
  yearBuilt     Int?
  lotSize       Float?
  latitude      Float?
  longitude     Float?
  notes         String?  @db.Text
  archivedAt    DateTime?
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  compAnalyses  CompAnalysis[]
  comps         Comp[]

  @@index([archivedAt])
  @@index([createdAt])
  @@map("property_lookups")
}

// Phase D: persisted condition reports from photo analysis runs.
// Append-on-reanalyze; the Deal Math drawer reads the most recent row
// (by analyzedAt DESC) and renders rooms/systems/redFlags/repairItems.
// Decoupled from the lead's currentRepairEstimateMethod so the user can
// switch to manual or AI methods while still viewing the latest report.
model PhotoAnalysisResult {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  resultJson      Json     // full condition report: rooms, systems, redFlags, repairItems, wholesalerNotes, overallCondition
  rangeLow        Float?
  rangeHigh       Float?
  midpoint        Float?
  photosAnalyzed  Int?
  analyzedAt      DateTime @default(now())

  @@index([leadId, analyzedAt(sort: Desc)])
  @@map("photo_analysis_results")
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  completed    Boolean   @default(false)
  completedAt  DateTime?
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("tasks")
}

model Note {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  isInternalComment Boolean @default(false)  // true = inline team comment in the timeline
  mentions  Json?    // array of mentioned userIds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notes")
}

model Activity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  type        String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("activities")
}

model DripSequence {
  id              String   @id @default(cuid())
  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status          String   @default("PENDING") // PENDING | ACTIVE | COMPLETED | CANCELLED
  currentStep     Int      @default(0)

  hasTimeline     Boolean  @default(false)
  hasCondition    Boolean  @default(false)
  hasOwnership    Boolean  @default(false)
  hasAskingPrice  Boolean  @default(false)

  initialDelayMs  Int      @default(60000)
  retryDelayMs    Int      @default(86400000)
  maxRetries      Int      @default(2)
  currentRetries  Int      @default(0)

  lastMessageAt   DateTime?
  lastReplyAt     DateTime?
  pausedReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("drip_sequences")
}

model DripSettings {
  id                  String   @id @default("default")
  initialDelayMs      Int      @default(60000)
  nextQuestionDelayMs Int      @default(30000)
  retryDelayMs        Int      @default(86400000)
  maxRetries          Int      @default(2)
  demoMode            Boolean  @default(false)

  // AI Outreach Toggles
  aiSmsEnabled        Boolean  @default(false)   // master switch for AI SMS drip
  aiCallEnabled       Boolean  @default(false)   // master switch for AI outbound calls
  callDelayMs         Int      @default(120000)  // delay before auto-call fires (default 2 min)

  updatedAt           DateTime @updatedAt

  @@map("drip_settings")
}

model AiPrompt {
  id              String   @id @default(cuid())
  name            String
  scenario        String   @unique
  contextRules    Json
  systemPrompt    String   @db.Text
  exampleMessages Json?
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_prompts")
}

// External conversations driven by partners (e.g. Closercontrol). These records
// are completely isolated from the Lead model and its automation. Dealcore only
// generates responses and extracts CAMP data; the partner owns sending,
// scheduling, opt-outs, pipeline, and everything else.
model ExternalConversation {
  id                String                        @id @default(cuid())
  partnerKey        String                        // which partner owns this (e.g. "closercontrol")
  externalId        String                        // partner's own conversation/lead ID
  sellerFirstName   String?
  sellerPhone       String?                       // optional, for debugging only — partner is source of truth
  extractedFields   Json                          @default("{}")
  campScore         Int?
  campBand          String?
  messageCount      Int                           @default(0)
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  // Set when a human user at the partner sends a message manually in their UI.
  // Detected via the presence of `userId` in outbound webhook payloads (our
  // API-sent messages don't have one). Once set, all subsequent inbound webhooks
  // for this conversation are ignored — the human owns the conversation now.
  humanTookOverAt   DateTime?
  humanTookOverBy   String?                       // partner's userId, for debugging
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  messages          ExternalConversationMessage[]

  @@unique([partnerKey, externalId])
  @@map("external_conversations")
}

model ExternalConversationMessage {
  id              String                @id @default(cuid())
  conversationId  String
  conversation    ExternalConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       String                // "INBOUND" | "OUTBOUND"
  body            String                @db.Text
  sentAt          DateTime
  createdAt       DateTime              @default(now())

  @@index([conversationId, sentAt])
  @@map("external_conversation_messages")
}

model Contract {
  id                   String    @id @default(cuid())
  leadId               String    @unique
  lead                 Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractStatus       String    @default("draft")    // draft/signed/inspection/past-inspection/at-title/closed/cancelled
  exitStrategy         String    @default("wholesale") // wholesale/novation/subject-to/creative/retail
  offerAmount          Float?    // purchase price offered to seller
  earnestMoney         Float?
  inspectionPeriodDays Int?
  sellerFinancing      Boolean   @default(false)
  contractDate         DateTime?
  buyerName            String?
  assignmentFee        Float?
  titleCompany         String?
  expectedCloseDate    DateTime?
  actualCloseDate      DateTime?
  dispositionNotes     String?   @db.Text
  outcome              String?
  boldsignDocumentId   String?
  boldsignStatus       String?   // pending/completed/declined/revoked
  boldsignSigningUrl   String?   @db.Text
  boldsignSentAt       DateTime?

  // ── Disposition v2: acquisition tracking ─────────────────────────────────
  acceptedOfferId         String?  @unique
  acceptedOffer           Offer?   @relation("ContractAcceptedOffer", fields: [acceptedOfferId], references: [id])
  acquisitionClosingCosts Float?
  fundingSource           String?  // cash | hard_money | private_money | seller_finance | jv_capital | other
  acquiredAt              DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("contracts")
}

model Offer {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offerAmount      Float
  offerDate        DateTime  @default(now())
  status           String    @default("pending") // pending/accepted/rejected/countered/withdrawn
  counterAmount    Float?
  notes            String?
  terms            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  acceptedForContract Contract? @relation("ContractAcceptedOffer")

  @@map("offers")
}

model CallLog {
  id           String   @id @default(cuid())
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vapiCallId       String?  @unique
  twilioCallSid    String?  @unique  // Twilio browser-dialer call (CallSid)
  fromNumber       String?           // dialer caller ID used
  toNumber         String?           // number dialed

  // Browser calls run through a Twilio Conference (rather than a plain <Dial>)
  // so the agent can hold and transfer. Participants carry stable labels:
  // 'agent' (the browser leg), 'customer' (the lead), 'consult' (a warm-transfer
  // target). conferenceName is derived from the agent leg's CallSid.
  conferenceName   String?
  // The seller's leg, dialled separately into the conference. Kept so hanging
  // up in the browser can cancel it: without this we can end the conference but
  // not a leg that is still ringing an unanswered phone.
  customerCallSid  String?
  transferState    String?           // null | warm_consulting | transferred
  transferTo       String?           // number the call was/is being transferred to
  disposition      String?           // post-call outcome (Voicemail, Follow Up, etc.)
  status           String   @default("queued")
  type             String   @default("ai_outbound")  // ai_outbound|twilio_browser|twilio_inbound
  transcript   String?  @db.Text
  summary      String?  @db.Text
  recordingUrl String?
  endedReason  String?
  duration     Int?
  initiatedByUserId String?   // user who started the call; null = AI/system
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("call_logs")
}

model OrgGmailToken {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  email          String       // e.g. deals@quickcashhomebuyers.com
  connectedBy    String       // userId of admin who connected it
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("org_gmail_tokens")
}

model GmailToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  email        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gmail_tokens")
}

model Email {
  id          String   @id @default(cuid())
  orgId       String
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  gmailMsgId  String?  @unique
  mailgunMessageId String? @unique // Mailgun Message-Id (with angle brackets stripped)
  messageIdHeader  String? // RFC 5322 Message-ID we set/received, for threading
  inReplyTo        String? // In-Reply-To header value on inbound replies
  threadId    String?
  direction   String
  fromAddress String
  toAddress   String
  subject     String
  bodyHtml    String?  @db.Text
  bodyText    String   @db.Text
  sentByUserId String?  // user who sent an outbound email; null = AI/system/inbound
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@map("emails")
}

// ─── Campaign / Re-engagement System ─────────────────────────────────────────

enum CampaignChannel {
  TEXT
  EMAIL
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  OPTED_OUT
  REMOVED
}

enum DripMessageStatus {
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SKIPPED
  OPENED
  CLICKED
  REPLIED
}

model Campaign {
  id             String   @id @default(cuid())
  name           String
  description    String?
  triggerDays    Int      @default(15)
  enrollmentMode String   @default("manual")  // "manual" | "auto"
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  organizationId String?
  /// E.164 number TEXT steps send from, e.g. a Florida campaign on the
  /// Jacksonville line. Null keeps the existing behaviour: the number already
  /// used on the lead's thread, else the org default. Validated against the
  /// active SMS numbers at send time, never trusted as stored.
  fromNumber     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps       CampaignStep[]
  enrollments CampaignEnrollment[]

  @@map("campaigns")
}

model CampaignStep {
  id              String          @id @default(cuid())
  campaignId      String
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepOrder       Int
  channel         CampaignChannel
  // delayDays/delayHours are CUMULATIVE offsets from CampaignEnrollment.enrolledAt,
  // not gaps from the previous step. A campaign with delays [0, 1, 2, 3] fires on
  // day 0, 1, 2, 3 from enrollment. See CampaignExecutionService.calculateNextSendAt.
  delayDays       Int             @default(0)
  delayHours      Int             @default(0)
  sendWindowStart String?
  sendWindowEnd   String?
  subject         String?
  body            String
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messageLogs CampaignMessageLog[]

  @@map("campaign_steps")
}

model CampaignEnrollment {
  id               String           @id @default(cuid())
  campaignId       String
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  enrolledAt       DateTime         @default(now())
  currentStepOrder Int              @default(0)
  status           EnrollmentStatus @default(ACTIVE)
  nextSendAt       DateTime?
  lastContactAt    DateTime?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  messageLogs CampaignMessageLog[]

  @@unique([campaignId, leadId])
  @@map("campaign_enrollments")
}

model CampaignMessageLog {
  id           String             @id @default(cuid())
  enrollmentId String
  enrollment   CampaignEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         CampaignStep       @relation(fields: [stepId], references: [id])
  channel      CampaignChannel
  sentAt       DateTime           @default(now())
  messageBody  String
  status       DripMessageStatus  @default(SENT)
  externalId   String?
  createdAt    DateTime           @default(now())

  @@map("campaign_message_logs")
}

// ─── Partners & Deal Sharing ─────────────────────────────────────────────────

model Partner {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  company        String?
  phone          String?
  type           String   @default("buyer")  // buyer | jv | title | lender | agent | other
  needsTypeReview Boolean @default(false)     // set during the legacy-type remap; user clears after reclassifying
  tags           Json     @default("[]")
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  lastSharedAt   DateTime?
  shareCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dealShares          DealShare[]
  jvDispositionPlans  DispositionPlan[] @relation("DispoJvPartner")
  finalSalesAsBuyer   FinalSale[]       @relation("FinalSaleBuyer")

  @@unique([organizationId, email])
  @@map("partners")
}

model DealShare {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sharedByUserId String
  channel        String   @default("resend")  // resend | gmail | org-gmail

  viewToken      String   @unique
  expiresAt      DateTime

  status         String   @default("sent")  // sent | opened | expired | error
  openedAt       DateTime?
  openCount      Int      @default(0)
  lastOpenedAt   DateTime?

  // Snapshot of deal numbers at time of share
  snapshotArv           Float?
  snapshotRepairCosts   Float?
  snapshotMao           Float?
  snapshotAskingPrice   Float?
  snapshotAssignmentFee Float?
  snapshotDealType      String?

  emailSubject   String?
  personalNote   String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([leadId])
  @@index([partnerId])
  @@index([viewToken])
  @@map("deal_shares")
}

// ─── Deal Search ─────────────────────────────────────────────────────────────

model DealSearchCache {
  id           String   @id @default(cuid())
  cacheKey     String   @unique              // SHA-256 hash of endpoint + geoIdV4 + params
  endpoint     String                        // ATTOM endpoint name
  geoIdV4      String                        // Area identifier (e.g. "ZI08902")
  params       Json                          // Full query params sent to ATTOM
  responseData Json                          // Raw ATTOM response
  resultCount  Int      @default(0)
  fetchedAt    DateTime @default(now())
  expiresAt    DateTime                      // fetchedAt + 48h (set in service code)

  @@index([cacheKey])
  @@index([expiresAt])
  @@map("deal_search_cache")
}

model SavedSearch {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  filters        Json                        // Serialized filter state
  resultCount    Int?
  lastRunAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("saved_searches")
}

// Settings > Messaging Compliance. Singleton, same pattern as DripSettings.
// Twilio does not prepend a sender name or append opt-out language the way the
// old provider did, so the footer is assembled here and applied in the SMS send
// path (first message per lead, then optionally every N days).
/// A Twilio number this org can send from. Replaces the TWILIO_CALLER_IDS env
/// var so numbers can be added, relabelled and re-defaulted without a redeploy.
/// Seeded from that env var on first boot (see PhoneNumberSeedService).
///
/// `isDefault` is the fallback for anything with no better signal: the dialer's
/// initial caller ID, and the first text to a brand-new lead. Replies do NOT
/// use it, they stick to whichever number that seller already knows.
model PhoneNumber {
  id           String   @id @default(cuid())
  number       String   @unique   // E.164, e.g. +17045299523
  label        String              // shown in the From picker, e.g. "Charlotte"
  smsEnabled   Boolean  @default(true)
  voiceEnabled Boolean  @default(true)
  isDefault    Boolean  @default(false)
  active       Boolean  @default(true)   // false hides it without losing history
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("phone_numbers")
}

model MessagingCompliance {
  id              String   @id @default("default")

  optOutEnabled   Boolean  @default(true)
  optOutText      String   @default("Reply STOP to stop texting")

  senderIdEnabled Boolean  @default(true)
  senderIdText    String   @default("Quick Cash Home Buyers")

  // When on, the footer is re-sent every `periodicDays` days instead of only
  // on the first message to a lead.
  periodicEnabled Boolean  @default(false)
  periodicDays    Int      @default(30)

  updatedAt       DateTime @updatedAt

  @@map("messaging_compliance")
}

// Action Queue: per-user state for the dashboard Action Queue. The queue items
// themselves are computed on read; these tables only persist user intent
// (dismissals, snoozes) and a "last seen" marker for unseen badging.
model ActionDismissal {
  id          String   @id @default(cuid())
  userId      String
  actionKey   String
  dismissedAt DateTime @default(now())

  @@unique([userId, actionKey])
  @@index([userId])
  @@map("action_dismissals")
}

model ActionSnooze {
  id           String   @id @default(cuid())
  userId       String
  actionKey    String
  snoozedUntil DateTime

  @@unique([userId, actionKey])
  @@index([userId, snoozedUntil])
  @@map("action_snoozes")
}

model ActionLastSeen {
  userId     String   @id
  lastSeenAt DateTime @default(now())

  @@map("action_last_seen")
}

// ─── Disposition v2: post-acquisition lifecycle ──────────────────────────────

// Intended/actual disposition plan for a lead. One per lead. Created when the
// user sets an exit strategy (typically pre-acquisition or at acquisition).
model DispositionPlan {
  id              String    @id @default(cuid())
  leadId          String    @unique
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  exitStrategy    String    // wholesale | novation | double_close | fix_flip | hold_rental | jv | sub_to | other
  targetSalePrice Float?
  targetCloseDate DateTime?
  jvPartnerId     String?
  jvPartner       Partner?  @relation("DispoJvPartner", fields: [jvPartnerId], references: [id])
  jvSplitMode     String?   // none | fifty_fifty | custom
  jvSplitPercent  Float?    // our-side percent when 'custom' (0-100)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("disposition_plans")
}

// Line-item costs incurred between acquisition and final sale. Many per lead.
model DispositionCost {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  category    String   // holding | repair_prep | utilities | marketing | closing | jv_payout | other
  description String?
  amount      Float
  incurredAt  DateTime @default(now())
  paidTo      String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@map("disposition_costs")
}

// Final sale event. One per lead. Created when the disposition closes.
model FinalSale {
  id               String   @id @default(cuid())
  leadId           String   @unique
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  buyerName        String?
  buyerPartnerId   String?
  buyerPartner     Partner? @relation("FinalSaleBuyer", fields: [buyerPartnerId], references: [id])
  finalSalePrice   Float
  saleClosingCosts Float?
  netProceeds      Float?
  closedAt         DateTime
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("final_sales")
}

model AiCompCuration {
  id                     String   @id @default(cuid())
  leadId                 String
  userId                 String
  createdAt              DateTime @default(now())
  subjectSnapshot        Json
  valuationMode          String   // "ARV_RENOVATED" | "AS_IS"
  hardConstraints        Json
  candidateIds           String[]
  excludedTypeMismatches Json
  excludedConstraints    Json
  searchExpansion        Json
  promptText             String   @db.Text
  promptVersion          String
  rawResponse            Json
  parsedResponse         Json?
  modelMetadata          Json
  isValidationRun        Boolean  @default(false)
  validationPropertyId   String?
  cacheKey               String
  rawCandidateCount      Int?
  uniqueCandidateCount   Int?
  dedupMetadata          Json?
  lead                   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user                   User     @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
  @@index([cacheKey])
  @@map("ai_comp_curations")
}

model AiArvCalculation {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation("LeadAiArvCalculations", fields: [leadId], references: [id], onDelete: Cascade)
  curationId        String?
  inputHash         String
  mode              String    // "ARV_RENOVATED" | "AS_IS"
  arv               Float
  arvLow            Float?
  arvHigh           Float?
  pricePerSqft      Float?
  confidence        Int
  confidenceLabel   String    // "LOW" | "MEDIUM" | "HIGH"
  resultJson        Json
  selectedCompIds   String[]
  reapiAvmAtCalc    Float?
  modelUsed         String?
  promptVersion     String?
  computedAt        DateTime  @default(now())
  computedByUserId  String?

  currentForLeads   Lead[]    @relation("LeadCurrentArvCalculation")

  @@index([leadId, computedAt(sort: Desc)])
  @@index([leadId, inputHash])
  @@map("ai_arv_calculations")
}

/// One row per Daily Brief send. `bigThingKey` is the identity of whatever led
/// the brief, so the next run can avoid opening with the same story several
/// mornings running. `metrics` is the board snapshot, for day-over-day deltas.
model DigestRun {
  id             String   @id @default(cuid())
  organizationId String
  sentAt         DateTime @default(now())
  bigThingKey    String?
  metrics        Json?

  @@index([organizationId, sentAt])
  @@map("digest_runs")
}

/// A foreclosure notice the team removed, kept so it stays removed.
///
/// Deleting the Lead cascades its ForeclosureDetail away, and dedupeUid /
/// noticeId / caseNumber on that row are the only memory ingestion has that a
/// notice was ever seen. Without this tombstone the next morning's feed pull
/// finds the same item looking brand new and recreates it, which is why
/// deleting a lead was what brought it back.
///
/// Keyed the same ways the dedupe lookup is, plus the address, so a re-filed
/// notice with a new sale date is suppressed too.
model ForeclosureSuppression {
  id              String   @id @default(cuid())
  organizationId  String?
  dedupeUid       String
  noticeId        String?
  caseNumber      String?
  addressKey      String?
  /// Human-readable, for working out later why something never appeared.
  propertyAddress String?
  reason          String   @default("deleted") // 'deleted' | 'merged'
  createdAt       DateTime @default(now())

  @@index([organizationId, dedupeUid])
  @@index([organizationId, addressKey])
  @@index([organizationId, caseNumber])
  @@map("foreclosure_suppressions")
}

/// One run of the Mecklenburg Times feed poll, cron or manual. Exists so the
/// foreclosures page can show when notices were last pulled without digging
/// through Railway logs, which age out. organizationId is nullable because the
/// cron takes it from FORECLOSURE_DEFAULT_ORG_ID, which may be unset.
model ForeclosurePollRun {
  id             String    @id @default(cuid())
  organizationId String?
  trigger        String                       // 'cron' | 'manual'
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  ok             Boolean   @default(false)
  scanned        Int       @default(0)
  created        Int       @default(0)
  skipped        Int       @default(0)
  pastDated      Int       @default(0)
  errors         Int       @default(0)
  message        String?

  @@index([startedAt])
  @@map("foreclosure_poll_runs")
}

/// One run of the surplus county poll, mirroring ForeclosurePollRun so the two
/// boards report health the same way. `classified` counts cases whose claim
/// status was resolved from the document list; `dead` counts those the classifier
/// retired (distributed or already assigned) rather than surfacing as leads.
/// A living person who inherited a claimant's interest, read off a probate
/// filing.
///
/// Hangs off SurplusDetail rather than becoming its own Lead, deliberately. The
/// money belongs to the PROPERTY and the claim is filed against one case, so
/// splitting the heirs into separate leads would put one surplus on two boards
/// and let somebody work half of it. An heir is a contact on the claim, the way
/// a co-owner is.
///
/// Every field here comes from a document a person read and confirmed. Nothing
/// on this table is inferred, because a wrong heir is worse than no heir: it is
/// a stranger being told they have money coming.
model SurplusHeir {
  id              String        @id @default(cuid())
  surplusDetailId String
  surplusDetail   SurplusDetail @relation(fields: [surplusDetailId], references: [id], onDelete: Cascade)
  organizationId  String?

  name         String
  /// As printed: "Son", "Daughter", "Surviving Spouse". Kept verbatim because
  /// it is what decides who can sign, and paraphrasing it loses that.
  relationship String?
  /// As printed: "50% Remainder Interest", "Life Estate". A life estate holder
  /// cannot sell alone, so this is not decoration.
  share        String?

  // Where they actually live, off the filing. This is the skip-trace target and
  // it is the whole point of reading the document: a 2025 petition carries a
  // current address for a person the tax roll still lists at the dead owner's
  // house.
  street String?
  city   String?
  state  String?
  zip    String?

  /// An heir can themselves be dead. The Spencer petition lists the surviving
  /// spouse as "ADULT, DECEASED DOD 03/25/2022", which means her share needs
  /// its own estate opened and she must never be dialled.
  deceased    Boolean   @default(false)
  dateOfDeath DateTime?

  // Contacts, found by skip trace or by hand. Their own columns rather than the
  // parent's, because the parent's belong to the dead claimant.
  phone1     String?
  phone2     String?
  phone3     String?
  phone4     String?
  phone1Type String?
  phone2Type String?
  phone3Type String?
  phone4Type String?
  phone1Dnc  String?
  phone2Dnc  String?
  phone3Dnc  String?
  phone4Dnc  String?
  email1     String?
  email2     String?

  // Trace state, same three columns and same meaning as SurplusDetail: "never
  // tried" and "tried and found nothing" need different next actions.
  tracedAt        DateTime?
  traceOutcome    String?
  traceDetail     String?
  contactMismatch Boolean   @default(false)
  mismatchedName  String?

  doNotCall Boolean @default(false)
  callNotes String?

  // Provenance. Which filing said so, so a disputed heir can be checked against
  // the document rather than argued about.
  sourceCaseNumber String?
  sourceDocument   String?
  /// 'probate_petition' | 'manual'
  sourceKind       String? @default("probate_petition")
  addedByUserId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surplusDetailId])
  @@index([organizationId, name])
  @@index([phone1])
  @@map("surplus_heirs")
}

/// A surplus case the team removed, kept so the next county poll cannot
/// recreate it.
///
/// The tombstone has to outlive the lead because deleting the lead cascades
/// SurplusDetail away, and with it the dedupeUid the poll matches on. Without
/// this row the case is simply absent the next morning, which reads to the poll
/// as a brand new case, and it comes back with every note, edited number and
/// Dead marking gone.
model SurplusSuppression {
  id             String   @id @default(cuid())
  organizationId String?
  dedupeUid      String
  county         String?
  caseNumber     String?
  claimant       String?
  /// Human-readable, for working out later why something never appeared.
  propertyAddress String?
  reason         String   @default("deleted")
  createdAt      DateTime @default(now())

  @@index([organizationId, dedupeUid])
  @@index([organizationId, caseNumber])
  @@map("surplus_suppressions")
}

model SurplusPollRun {
  id             String    @id @default(cuid())
  organizationId String?
  trigger        String                       // 'cron' | 'manual'
  source         String?                      // 'duval_taxdeed' | 'realtdm'
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  ok             Boolean   @default(false)
  scanned        Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  skipped        Int       @default(0)
  belowFloor     Int       @default(0)
  classified     Int       @default(0)
  dead           Int       @default(0)
  errors         Int       @default(0)
  message        String?

  @@index([startedAt])
  @@map("surplus_poll_runs")
}
